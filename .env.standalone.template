# ==============================================================================
# Docker Compose Environment Variables (Standalone Mode)
# Этот файл используется ТОЛЬКО для конфигурации Docker-контейнеров.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM / AI Configuration (Ollama)
# Настройки для подключения к локальному LLM-провайдеру.
# ------------------------------------------------------------------------------
# ВАЖНО: Внутри Docker-сети обращение идет по имени сервиса ('ollama'), а не localhost!
LLM_BASE_URL=http://ollama:11434/v1

# Ollama не требует реального ключа, но пакет openai-php/client ожидает строку.
LLM_API_KEY=ollama_dummy_key

# Модель для анализа тональности.
# qwen2.5:1.5b - идеальный баланс: весит ~1 ГБ, быстро грузится, отлично держит JSON-схемы.
# При желании можно сменить на qwen2.5:3b или qwen2.5:7b (потребуется больше RAM).
LLM_MODEL=qwen2.5:1.5b
