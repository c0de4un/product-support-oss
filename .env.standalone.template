# ==============================================================================
# Docker Compose Environment Variables (Standalone Mode)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM / AI Configuration (Ollama)
# ------------------------------------------------------------------------------
# Внутри Docker-сети обращение идет по имени сервиса ('ollama'),
# но для локального backend (cargo run) мы будем использовать localhost.
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama_dummy_key

# Чат-модель для генерации ответов
LLM_MODEL=qwen2.5:1.5b-instruct

# Embedding-модель для векторного поиска (RAG)
# nomic-embed-text весит ~270MB, отлично работает с английским и русским, dim=768
EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 2. Qdrant Configuration (Vector Database)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=product_support_chunks
VECTOR_DIM=768
